10 REM FOR / NEXT checks (the answers are in tests/mk09_test.py)
20 S=0:FOR I=1 TO 100:S=S+I:NEXT I:PRINT S
30 S=0:FOR I=10 TO 1 STEP -1:S=S+I:NEXT:PRINT S
40 S=0:FOR I=-3 TO 3:S=S+I*I:NEXT I:PRINT S;I
50 S=0:FOR I=0 TO 4:S=S+1:IF I=2 THEN I=3
60 NEXT I:PRINT S;I
70 S=0:FOR I=1 TO 2 STEP .5:S=S+1:NEXT I:PRINT S
80 S=0:FOR I=5 TO 1:S=S+1:NEXT I:PRINT S;I
90 S=0:FOR I=1 TO 3:FOR J=1 TO I:S=S+1:NEXT J,I:PRINT S
100 S=0:FOR I=0 TO 40:S=S+I:NEXT I:PRINT S
110 S=0:FOR I=40 TO 0 STEP -1:S=S+I:NEXT I:PRINT S
120 S=0:FOR I=3 TO -3 STEP -1:S=S+1:NEXT I:PRINT S;I
130 S=0:FOR I=-2 TO 2:S=S*2+I:NEXT I:PRINT S
140 S=0:FOR I=65530 TO 65540:S=S+1:NEXT I:PRINT S;I
