0063:                   * READ
0063:                   * Entry: U = Static Storage
0063:                   *        Y = Path Descriptor
0063:                   * Exit:  A = Character read
0063:                   *
0063:                   *   Take a byte from the receive ring, sleep when it is empty (the interrupt wakes the process)
0063:                   *
0063: 3401              READ     pshs  cc
0065: 1A50              readlp   orcc  #IntMasks
0067: E6C81E                     ldb   RxTail,u
006A: E1C81D                     cmpb  RxHead,u
006D: 2710                       beq   readslp
006F: 30C822                     leax  RxBuf,u
