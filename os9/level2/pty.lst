017E:                   **********************
017E:                   * IRQSvc - the interrupt service routine
017E:                   *   Entry: U = Static storage.  Exit: carry clear (the interrupt was ours)
017E:                   *
017E:                   *   Loop while the ACIA has something: a received character goes through the special character checks into
017E:                   *   the ring, a transmit interrupt sends the next character of the transmit ring (the last one turns the
017E:                   *   transmit interrupt off).  At the end a process that waits for us is woken.
017E:                   *
017E: AE41              IRQSvc   ldx   V.PORT,u
0180: E684              isrlp    ldb   ,x
0182: C501                       bitb  #St.RxF
0184: 2741                       beq   isrtx
0186: A601                       lda   1,x                the character (this also clears the interrupt request)
0188: 2725                       beq   isrput             a null is a normal character
018A: A14B                       cmpa  V.INTR,u
018C: 2604                       bne   isrq
018E: C603                       ldb   #S$Intrpt          keyboard interrupt
0190: 2006                       bra   isrsig
0192: A14C              isrq     cmpa  V.QUIT,u
0194: 260F                       bne   isrp
0196: C602                       ldb   #S$Abort           keyboard abort
0198: 3402              isrsig   pshs  a
019A: A643                       lda   V.LPRC,u           the last process that used the terminal
019C: 2703                       beq   isrsg1
019E: 103F08                     os9   F$Send
01A1: 3502              isrsg1   puls  a
01A3: 200A                       bra   isrput
01A5: A14D              isrp     cmpa  V.PCHR,u
01A7: 2606                       bne   isrput
01A9: AE49                       ldx   V.DEV2,u           pause output of the device that echoes
01AB: 2702                       beq   isrput
01AD: A708                       sta   V.PAUS,x
01AF: E6C81D            isrput   ldb   RxHead,u
01B2: 30C822                     leax  RxBuf,u
01B5: 3A                         abx                      B is unsigned: B,X would sign extend it
01B6: A784                       sta   ,x
01B8: 5C                         incb
01B9: C47F                       andb  #RxMask
01BB: E1C81E                     cmpb  RxTail,u           a full ring loses the character
01BE: 2703                       beq   isrnxt
01C0: E7C81D                     stb   RxHead,u
01C3: AE41              isrnxt   ldx   V.PORT,u
01C5: 20B9                       bra   isrlp
01C7: C502              isrtx    bitb  #St.TxE
01C9: 2726                       beq   isrend
01CB: A6C821                     lda   CtlShd,u
01CE: 8520                       bita  #Cr.TIE
01D0: 271F                       beq   isrend
01D2: E6C820                     ldb   TxTail,u
01D5: E1C81F                     cmpb  TxHead,u
01D8: 2710                       beq   isrtxe
01DA: 31C900A2                   leay  TxBuf,u
01DE: A6A5                       lda   b,y
01E0: A701                       sta   1,x
01E2: 5C                         incb
01E3: C43F                       andb  #TxMask
01E5: E7C820                     stb   TxTail,u
01E8: 2096                       bra   isrlp
01EA: 84DF              isrtxe   anda  #^Cr.TIE           the ring is empty: no more transmit interrupts
01EC: A7C821                     sta   CtlShd,u
01EF: A784                       sta   ,x
01F1: A645              isrend   lda   V.WAKE,u           a process waits for a character or for room in the ring?
01F3: 2707                       beq   isrret
01F5: 6F45                       clr   V.WAKE,u
01F7: C601                       ldb   #S$Wake
01F9: 103F08                     os9   F$Send
01FC: 5F                isrret   clrb
01FD: 39                         rts
