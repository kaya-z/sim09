0075: 5C                         incb
0076: C47F                       andb  #RxMask
0078: E7C81E                     stb   RxTail,u
007B: 3501                       puls  cc
007D: 5F                         clrb
007E: 39                         rts
007F: A644              readslp  lda   V.BUSY,u           the process to wake
0081: A745                       sta   V.WAKE,u
0083:                   * the interrupts stay masked up to the call: a character cannot slip in between the check and the sleep
0083: 8E0000                     ldx   #0                 until the ISR sends the wake-up signal
0086: 103F0A                     os9   F$Sleep
0089: BE0050                     ldx   >D.Proc
008C: E68819                     ldb   P$Signal,x         a signal for us (^C ^E, or a kill)?
008F: 2708                       beq   readst
0091: C103                       cmpb  #S$Intrpt
0093: 2204                       bhi   readst
0095: 3501                       puls  cc                 the signal code is the error, like with the other SCF drivers
0097: 43                         coma
0098: 39                         rts
0099: E60C              readst   ldb   P$State,x
009B: C502                       bitb  #Condem
009D: 27C6                       beq   readlp
009F: 3501                       puls  cc
00A1: 53                         comb
00A2: C6E4                       ldb   #E$PrcAbt
00A4: 39                         rts
