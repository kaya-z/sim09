00D3: E6E4                       ldb   ,s         get 1st 2 digits (century)
00D5: C013                       subb  #19        subtract 19 from century +BGP+
00D7: 8664                       lda   #100       now we will +BGP+
00D9: 3D                         mul              multiply difference * 100, now B holds 0, 100 or 200 +BGP+
00DA: EB61                       addb  1,s        add os9's year to century byte +BGP+
00DC: E761                       stb   1,s        save back in year
00DE: 3061                       leax  1,s
00E0: 103F16                     os9   F$STime
