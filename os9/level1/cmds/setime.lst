00A5:                   * BGP: following lines added in case CR is pressed at prompt.  No need to set time
00A5:                   *      if there is nothing to process
00A5: A680              GetNext  lda   ,x+              +BGP+
00A7: 810D                       cmpa  #C$CR            +BGP+
00A9: 2755                       beq   L00DF            +BGP+
00AB: 8120                       cmpa  #C$SPAC          +BGP+
00AD: 27F6                       beq   GetNext          +BGP+
00AF: 812C                       cmpa  #C$COMA          +BGP+
00B1: 27F2                       beq   GetNext          +BGP+
00B3: 301F                       leax  -1,x             +BGP+
00B5:                   
00B5:                   * Make room for time packet on stack
00B5: 3279                       leas  -7,s
00B7: 8D4B                       bsr   L00E3
00B9: E7E4                       stb   ,s
00BB: 8D47                       bsr   L00E3
00BD: E761                       stb   $01,s
00BF: 8D43                       bsr   L00E3
